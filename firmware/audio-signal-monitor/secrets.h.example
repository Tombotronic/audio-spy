#pragma once

// NTP time sync
#define NTP_SERVER "pool.ntp.org"
// POSIX time zone rule, including when DST starts/ends (this one: Central
// Europe). If TZ_INFO is left out, the fixed offsets below are used instead.
#define TZ_INFO "CET-1CEST,M3.5.0,M10.5.0/3"
#define GMT_OFFSET_SEC 3600      // fallback: offset from UTC
#define DAYLIGHT_OFFSET_SEC 0    // fallback: fixed DST offset, applied all year
